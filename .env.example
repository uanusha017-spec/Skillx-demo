# GEMINI_API_KEY: Required for server-side Google Search Grounding, School Lab Verification,
# Missing Contact Lookup, and Industry-Specific Business Analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERPFORGE_API_KEY: Optional Serper-compatible search API key (configured via Settings > Secrets).
# When unset, built-in Gemini Google Search Grounding handles all live Google searches automatically.
SERPFORGE_API_KEY=""

# SERPFORGE_BASE_URL: Optional base URL for a Serper-compatible search API endpoint.
SERPFORGE_BASE_URL="https://serpforge.ai.studio/api/v1"

# PORTAL_ADMIN_PASSCODE: Optional shared workspace passcode for role-based portal sign-in.
# When unset, the app prompts for a one-time first-run workspace passcode on first login.
PORTAL_ADMIN_PASSCODE=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
